{
  "extends": ["react-app", "react-app/jest", "prettier"],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "warn",
    "react/prop-types": "warn",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-script-url": "error",
    "no-alert": "warn",
    "prefer-const": "error",
    "no-var": "error",
    "eqeqeq": ["error", "always"],
    "curly": ["error", "all"]
  }
}
