{
  "name": "fumigacion-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@turf/area": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/turf": "^7.2.0",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "prop-types": "^15.8.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.13.1",
    "react-scripts": "5.0.1",
    "recharts": "^3.2.1",
    "styled-components": "^6.1.19",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "nodemon --exec \"npm start\"",
    "dev:watch": "nodemon --watch src --ext js,jsx,ts,tsx,css,scss --exec \"npm start\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --ci",
    "test:watch": "nodemon --exec \"npm test\"",
    "eject": "react-scripts eject",
    "lint": "eslint src/ --max-warnings=0",
    "lint:fix": "eslint src/ --fix --max-warnings=0",
    "format": "prettier --write \"src/**/*.{js,jsx,json,css,md}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,md}\" \"docs/**/*.md\" \"*.{json,md}\"",
    "validate": "npm run lint && npm run test:ci && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ],
    "docs/**/*.md": [
      "prettier --write"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.36.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3"
  }
}
